{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#12.0.0",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#12.0.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#12.0.0",
    ":timezone(Europe/London)",
  ],
  // The Protect Main ruleset does not require up-to-date branches, and the default `auto` would rebase every
  // open pull request, rerunning CI, each time main moves. Rebase only when a branch conflicts.
  rebaseWhen: "conflicted",
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 3am on the first day of the month"],
    commitMessageExtra: "({{manager}})",
    additionalBranchPrefix: "{{manager}}-",
  },
  packageRules: [
    // Auto-merge rules. Later rules win: the broad patch rule comes first and the critical-component
    // exclusion comes last, so nothing below can re-enable a package it lists.
    {
      description: "Auto-merge container and chart patch updates after a soak period",
      matchDatasources: ["docker", "helm"],
      matchUpdateTypes: ["patch"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "3 days",
      ignoreTests: false,
    },
    {
      description: "Auto-merge minor updates of low-risk leaf apps after a soak period",
      matchDatasources: ["docker", "helm"],
      matchUpdateTypes: ["minor"],
      matchPackageNames: [
        "/home-operations\\/(prowlarr|radarr|sonarr|lidarr|readarr|sabnzbd|qbittorrent)/",
        "/seerr/",
        "/gethomepage\\/homepage/",
        "/haveagitgat\\/tdarr/",
        "/music-assistant\\/server/",
      ],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "3 days",
      ignoreTests: false,
    },
    {
      description: "Auto-merge trusted OCI digests",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      matchPackageNames: ["/home-operations/", "/fma965/"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Auto-merge high-cadence OCI packages weekly",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/kube-prometheus-stack/"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
      schedule: ["before 6am on Monday"],
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "3 days",
      ignoreTests: false,
    },
    {
      description: "Auto-merge trusted GitHub Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: ["/^actions\\//"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "1 minute",
      ignoreTests: false,
    },
    {
      description: "Auto-merge Grafana dashboards",
      matchDatasources: ["custom.grafana-dashboards"],
      matchUpdateTypes: ["major"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Auto-merge Renovate Presents",
      matchManagers: ["renovate-config"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      // Last of the auto-merge rules on purpose: later rules win, so this also beats the trusted-digest rule
      // above (a digest-only bump of a home-operations image such as kopiur or vchord must not merge itself).
      // Limited to container and chart updates so GitHub Actions rules still apply.
      description: "Never auto-merge cluster-critical components (DNS, CNI, storage, backups, databases, secrets, ingress, auth, GitOps, Talos)",
      matchDatasources: ["docker", "helm"],
      matchPackageNames: [
        "/siderolabs/",
        "/kube-(apiserver|controller-manager|proxy|scheduler)/",
        "/kubelet/",
        "/coredns/",
        "/cilium/",
        "/rook-ceph/",
        "/ceph/",
        "/cloudnative-pg/",
        "/postgres/",
        "/kopiur/",
        "/doco-cd/",
        "/envoy/",
        "/external-secrets/",
        "/external-dns/",
        "/cert-manager/",
        "/onepassword/",
        "/flux/",
        "/pocket-id/",
        "/etcd/",
        "/tuppr/",
        "/dragonfly/",
        "/openebs/",
        "/multus/",
        "/vchord/",
        "/plugin-barman-cloud/",
      ],
      automerge: false,
    },
    // Grouping rules
    {
      description: "Actions Runner Controller Group",
      groupName: "actions-runner-controller",
      matchDatasources: ["docker"],
      matchPackageNames: ["/gha-runner-scale-set-controller/", "/gha-runner-scale-set/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Dragonfly Operator Group",
      groupName: "dragonfly-operator",
      matchDatasources: ["docker", "github-releases"],
      matchPackageNames: ["/dragonfly(?:db)?.operator/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Intel Device Plugins Group",
      groupName: "intel-device-plugins",
      matchDatasources: ["docker"],
      matchPackageNames: ["/intel-device-plugins-operator/", "/intel-device-plugins-gpu/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Kubernetes Group",
      groupName: "kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 5,
    },
    {
      // Scheduled tools stay out: a grouped branch takes its schedule from
      // whichever update sorts first
      description: "Mise Tools Group",
      matchManagers: ["mise"],
      matchDepNames: ["!node", "!oxfmt"],
      groupName: "mise tools",
      groupSlug: "mise-tools",
    },
    {
      description: "Rook-Ceph Group",
      groupName: "rook-ceph",
      matchDatasources: ["docker"],
      matchPackageNames: ["/rook-ceph/", "/rook-ceph-cluster/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      // After the mise tools catch-all so talos wins its own group; unites the
      // mise pin, the factory installer image, and the tuppr upgrade version
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: ["siderolabs/talos"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "1Password CLI is not resolvable on GitHub, bump manually",
      matchManagers: ["mise"],
      matchDepNames: ["1password-cli"],
      enabled: false,
    },
    // Scheduling rules
    {
      description: "High-cadence mise tools monthly",
      matchManagers: ["mise"],
      matchDepNames: ["node", "oxfmt"],
      schedule: ["before 3am on the first day of the month"],
    },
    // Labeling rules
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"],
    },
  ],
}
